<header class="site-header">
  <nav class="header-nav">
    <div class="nav-left">

      <a class="brand" href="{{ '/' | url }}">
        <img class="brand-logo" src="/img/logo.svg" alt="ProjT" />
        <span class="brand-name">ProjT Launcher</span>
      </a>
    </div>
    
    <div class="nav-center">
      <ul class="nav-menu">
        {%- for entry in collections.nav | eleventyNavigation %}
        <li><a href="{{ entry.url | url }}"{% if entry.url == page.url %} class="active"{% endif %}>{{ entry.title }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    
    <div class="nav-right">
      <a class="nav-link" href="mailto:yongdohyun@projtlauncher.projecttick.org.tr" aria-label="Email">
        <i class="fa fa-envelope"></i>
      </a>
      <a href="https://matrix.to/#/#projtlauncher:matrix.org" target="_blank" class="nav-link" aria-label="Matrix">
        <i class="fa fa-comments"></i>
      </a>
      <a href="https://github.com/Project-Tick/ProjT-Launcher" target="_blank" class="nav-link" aria-label="GitHub">
        <i class="fa fa-github"></i>
      </a>
      <a href="{{ '/download/?from=button' | url }}" class="btn btn-primary">Download</a>
    </div>
  </nav>
</header>

{% if hero %}
<section class="hero">
  <div class="hero-content">
    <h1 class="hero-title">{{ hero.title }}</h1>
    <p class="hero-subtitle">{{ hero.description }}</p>
    
    <div class="hero-actions">
      <a href="{{ hero.button.url | url }}" class="btn btn-white"><i class="fa fa-download"></i> {{ hero.button.content }}</a>
      <a href="https://github.com/Project-Tick/ProjT-Launcher" target="_blank" class="btn btn-outline">View on GitHub</a>
    </div>
  </div>
  
  <div class="hero-visual">
    {%- if hero.image %}
    <div class="app-showcase">
      <img src="{{ hero.image.light }}" alt="ProjT Launcher Screenshot">
    </div>
    {%- endif %}
  </div>
</section>
{% endif %}
