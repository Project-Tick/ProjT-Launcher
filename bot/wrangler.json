{
  "name": "projtlauncher-bot",
  "main": "index.js",
  "compatibility_date": "2024-07-01",
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "vars": {
    "GITHUB_OWNER": "Project-Tick",
    "GITHUB_REPO": "ProjT-Launcher",
    "BOT_DRY_RUN": "false"
  },
  "observability": {
    "logs": {
      "enabled": false,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
