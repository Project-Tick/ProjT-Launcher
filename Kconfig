	bool "MinGW-w64"
	depends on TARGET_WINDOWS

config TOOLCHAIN_APPLE_CLANG
	bool "Apple Clang"
	depends on TARGET_MACOS || TARGET_IOS

config TOOLCHAIN_ANDROID_NDK
	bool "Android NDK Clang"
	depends on TARGET_ANDROID

config TOOLCHAIN_EMSCRIPTEN
	bool "Emscripten"
	depends on TARGET_WASM

config TOOLCHAIN_ZIG
	bool "Zig CC"
	help
	  Use Zig as a C/C++ compiler for cross-compilation.

endchoice

menu "Toolchain Paths"

config CROSS_COMPILE
	string "Cross-compile prefix"
	default ""
	help
	  Prefix for cross-compilation tools, e.g.:
	  - x86_64-w64-mingw32- for Windows
	  - aarch64-linux-gnu- for ARM64 Linux
	  - x86_64-apple-darwin- for macOS

config SYSROOT
	string "Sysroot path"
	default ""
	help
	  Path to target system root for cross-compilation.

