menu "Features"

config ENABLE_JAVA_DOWNLOADER
	bool "Enable Java downloader feature"
	default y
	help
	  Allow the launcher to download and manage Java installations.

config ENABLE_UPDATER
	bool "Enable auto-updater"
	default y
	help
	  Include the self-update functionality.

config ENABLE_NEWS
	bool "Enable news feed"
	default y
	help
	  Show news from the project website.

config ENABLE_DISCORD_RPC
	bool "Enable Discord Rich Presence"
	default y
	help
	  Show game status in Discord.

config ENABLE_GAMEMODE
	bool "Enable GameMode integration (Linux)"
	default y
	depends on TARGET_LINUX || TARGET_AUTO
	help
	  Integrate with Feral's GameMode for performance optimization.

config ENABLE_MANGOHUD
	bool "Enable MangoHud integration (Linux)"
	default y
	depends on TARGET_LINUX || TARGET_AUTO
	help
	  Support for MangoHud overlay.

endmenu

