# ============================================================================
# Developer Options
# ============================================================================

menu "Developer Options"

config VERBOSE_BUILD
	bool "Verbose build output"
	default n
	help
	  Show full compiler commands instead of abbreviated output.

config CCACHE
	bool "Use ccache"
	default y
	help
	  Use ccache to speed up rebuilds.

config DISTCC
	bool "Use distcc for distributed compilation"
	default n
	help
	  Distribute compilation across multiple machines.

config COMPILE_COMMANDS
	bool "Generate compile_commands.json"
	default y
	help
	  Generate compilation database for IDE integration.

config PARALLEL_JOBS
	int "Default parallel jobs (0 = auto)"
	default 0
	help
	  Number of parallel compilation jobs. 0 means auto-detect
	  based on CPU cores.

endmenu
