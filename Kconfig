# ============================================================================
# ProjT-Launcher Kernel-style Configuration
# ============================================================================
#
# This is the main configuration file for the ProjT-Launcher build system.
# Use 'make menuconfig' to configure, 'make' to build.
#
# ============================================================================

mainmenu "ProjT-Launcher Configuration"

# ============================================================================
# Build Settings
# ============================================================================

menu "Build Settings"

choice
	prompt "Build Type"
	default BUILD_RELEASE

config BUILD_DEBUG
	bool "Debug"
	help
	  Debug build with full symbols and no optimization.
	  Enables assertions and extra runtime checks.

config BUILD_RELEASE
	bool "Release"
	help
	  Optimized release build with minimal debug info.

config BUILD_RELWITHDEBINFO
	bool "Release with Debug Info"
	help
	  Optimized build that retains debug information.

config BUILD_MINSIZEREL
	bool "Minimum Size Release"
	help
	  Optimized for smallest binary size.

endchoice

menu "Optimization"

choice
	prompt "Optimization Level"
	default OPT_O2

config OPT_O0
	bool "-O0 (No optimization)"

config OPT_O1
	bool "-O1 (Basic optimization)"

config OPT_O2
	bool "-O2 (Standard optimization)"

config OPT_O3
	bool "-O3 (Aggressive optimization)"

config OPT_Os
	bool "-Os (Optimize for size)"

config OPT_Oz
	bool "-Oz (Aggressive size optimization)"

config OPT_Ofast
	bool "-Ofast (Fast math, may break IEEE compliance)"

endchoice

config OPTLEVEL
	string
	default "-O0" if OPT_O0
	default "-O1" if OPT_O1
	default "-O2" if OPT_O2
	default "-O3" if OPT_O3
	default "-Os" if OPT_Os
	default "-Oz" if OPT_Oz
	default "-Ofast" if OPT_Ofast

config LTO
	bool "Enable Link Time Optimization (LTO)"
	default y
	help
	  Enable LTO for better optimization across translation units.
	  Significantly increases link time but produces smaller/faster code.

config LTO_THIN
	bool "Use ThinLTO (Clang only)"
	depends on LTO && TOOLCHAIN_CLANG
	default y
	help
	  Use ThinLTO instead of full LTO. Faster linking with most
	  of the optimization benefits.

config PGO
	bool "Enable Profile-Guided Optimization"
	default n
	help
	  Build with PGO support. Requires two-phase build:
	  1. Build instrumented binary
	  2. Run workload to collect profile data
	  3. Rebuild with profile data

choice
	prompt "PGO Phase"
	depends on PGO
	default PGO_GENERATE

config PGO_GENERATE
	bool "Generate profile"

config PGO_USE
	bool "Use profile"

endchoice

config PGO_DATA_DIR
	string "PGO data directory"
	depends on PGO
	default "$(OBJDIR)/pgo"

endmenu

menu "Debug Options"

config DEBUG_SYMBOLS
	bool "Include debug symbols"
	default y if BUILD_DEBUG || BUILD_RELWITHDEBINFO
	help
	  Include debug symbols in the binary.

choice
	prompt "Debug symbol format"
	depends on DEBUG_SYMBOLS
	default DEBUG_DWARF5

config DEBUG_DWARF4
	bool "DWARF 4"

config DEBUG_DWARF5
	bool "DWARF 5"

config DEBUG_SPLIT
	bool "Split DWARF (separate .dwo files)"

endchoice

config DEBUG_SPLIT_DIR
	string "Split debug directory"
	depends on DEBUG_SPLIT
	default "$(OBJDIR)/debug"

config ASSERTIONS
	bool "Enable assertions"
	default y if BUILD_DEBUG
	default n if !BUILD_DEBUG
	help
	  Enable assert() and Q_ASSERT() macros.

config QT_DEBUG
	bool "Qt debug messages"
	default y if BUILD_DEBUG
	help
	  Enable Qt debug/warning/info messages.

endmenu

menu "Sanitizers"
	depends on BUILD_DEBUG || BUILD_RELWITHDEBINFO

config SANITIZERS
	bool "Enable sanitizers"
	default n
	help
	  Enable address/memory/thread sanitizers for debugging.

if SANITIZERS

config ASAN
	bool "Address Sanitizer (ASan)"
	default y
	help
	  Detect memory errors: buffer overflow, use-after-free, etc.

config ASAN_RECOVER
	bool "ASan recoverable mode"
	depends on ASAN
	default n
	help
	  Continue execution after ASan detects an error.

config UBSAN
	bool "Undefined Behavior Sanitizer (UBSan)"
	default y
	help
	  Detect undefined behavior: integer overflow, null deref, etc.

config TSAN
	bool "Thread Sanitizer (TSan)"
	default n
	help
	  Detect data races. Cannot be used with ASan.

config MSAN
	bool "Memory Sanitizer (MSan)"
	default n
	depends on TOOLCHAIN_CLANG
	help
	  Detect use of uninitialized memory. Clang only.
	  Cannot be used with ASan.

config LSAN
	bool "Leak Sanitizer (LSan)"
	default n
	help
	  Detect memory leaks. Included with ASan by default.

config CFISAN
	bool "Control Flow Integrity (CFI)"
	default n
	depends on TOOLCHAIN_CLANG && LTO
	help
	  Detect control flow hijacking. Requires Clang and LTO.

endif # SANITIZERS

endmenu

menu "Security Hardening"

config STACK_PROTECTOR
	bool "Stack protector"
	default y
	help
	  Enable stack canaries to detect buffer overflows.

choice
	prompt "Stack protector level"
	depends on STACK_PROTECTOR
	default STACK_PROTECTOR_STRONG

config STACK_PROTECTOR_BASIC
	bool "-fstack-protector"

config STACK_PROTECTOR_STRONG
	bool "-fstack-protector-strong"

config STACK_PROTECTOR_ALL
	bool "-fstack-protector-all"

endchoice

config FORTIFY_SOURCE
	bool "FORTIFY_SOURCE"
	default y
	help
	  Enable compile-time and runtime buffer overflow checks.

choice
	prompt "FORTIFY level"
	depends on FORTIFY_SOURCE
	default FORTIFY_2

config FORTIFY_1
	bool "_FORTIFY_SOURCE=1"

config FORTIFY_2
	bool "_FORTIFY_SOURCE=2"

config FORTIFY_3
	bool "_FORTIFY_SOURCE=3"

endchoice

config PIE
	bool "Position Independent Executable"
	default y
	help
	  Build position-independent code for ASLR support.

config RELRO
	bool "RELRO (Relocation Read-Only)"
	default y
	help
	  Mark relocation sections read-only after relocation.

config RELRO_FULL
	bool "Full RELRO"
	depends on RELRO
	default y
	help
	  Resolve all symbols at load time (slower startup).

config BIND_NOW
	bool "Bind now (immediate binding)"
	default y
	help
	  Resolve all symbols at load time.

endmenu

endmenu

# ============================================================================
# Target Platform
# ============================================================================

menu "Target Platform"

choice
	prompt "Target Operating System"
	default TARGET_AUTO

config TARGET_AUTO
	bool "Auto-detect (same as host)"

config TARGET_LINUX
	bool "Linux"

config TARGET_WINDOWS
	bool "Windows"

config TARGET_MACOS
	bool "macOS"

config TARGET_FREEBSD
	bool "FreeBSD"

config TARGET_OPENBSD
	bool "OpenBSD"

config TARGET_NETBSD
	bool "NetBSD"

config TARGET_ANDROID
	bool "Android"

config TARGET_IOS
	bool "iOS"

config TARGET_WASM
	bool "WebAssembly"

config TARGET_HAIKU
	bool "Haiku"

endchoice

choice
	prompt "Target Architecture"
	default ARCH_AUTO

config ARCH_AUTO
	bool "Auto-detect (same as host)"

config ARCH_X86_64
	bool "x86_64 (AMD64)"

config ARCH_X86
	bool "x86 (i686)"

config ARCH_AARCH64
	bool "AArch64 (ARM64)"

config ARCH_ARM
	bool "ARM (32-bit)"

config ARCH_RISCV64
	bool "RISC-V 64-bit"

config ARCH_RISCV32
	bool "RISC-V 32-bit"

config ARCH_PPC64LE
	bool "PowerPC 64-bit LE"

config ARCH_S390X
	bool "s390x (IBM Z)"

config ARCH_LOONGARCH64
	bool "LoongArch 64-bit"

config ARCH_MIPS64
	bool "MIPS64"

config ARCH_WASM32
	bool "WebAssembly 32-bit"

endchoice

config TARGET_OS
	string
	default "" if TARGET_AUTO
	default "linux" if TARGET_LINUX
	default "windows" if TARGET_WINDOWS
	default "macos" if TARGET_MACOS
	default "freebsd" if TARGET_FREEBSD
	default "openbsd" if TARGET_OPENBSD
	default "netbsd" if TARGET_NETBSD
	default "android" if TARGET_ANDROID
	default "ios" if TARGET_IOS
	default "wasm" if TARGET_WASM
	default "haiku" if TARGET_HAIKU

config TARGET_ARCH
	string
	default "" if ARCH_AUTO
	default "x86_64" if ARCH_X86_64
	default "x86" if ARCH_X86
	default "aarch64" if ARCH_AARCH64
	default "arm" if ARCH_ARM
	default "riscv64" if ARCH_RISCV64
	default "riscv32" if ARCH_RISCV32
	default "ppc64le" if ARCH_PPC64LE
	default "s390x" if ARCH_S390X
	default "loongarch64" if ARCH_LOONGARCH64
	default "mips64" if ARCH_MIPS64
	default "wasm32" if ARCH_WASM32

menu "Linux Options"
	depends on TARGET_LINUX || TARGET_AUTO

config LINUX_APPIMAGE
