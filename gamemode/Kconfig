# Kconfig performance optimization
# Included from main Kconfig

menuconfig GAMEMODE
	bool "gamemode - Linux performance client"
	default y
	depends on TARGET_LINUX || TARGET_AUTO
	help
	  Client library for Feral Interactive's GameMode daemon.
	  Enables performance optimizations when running games.

if GAMEMODE

config GAMEMODE_VERSION
	string "gamemode version"
	default "1.8.2"

menu "Features"

config GAMEMODE_AUTO_START
	bool "Auto-start GameMode with game launch"
	default y
	help
	  Automatically request GameMode when launching a game.

config GAMEMODE_AUTO_STOP
	bool "Auto-stop GameMode when game exits"
	default y
	help
	  Automatically release GameMode when game exits.

config GAMEMODE_CHECK_DAEMON
	bool "Check for GameMode daemon"
	default y
	help
	  Check if gamemoded is running before trying to use it.

endmenu

menu "Optimizations"

config GAMEMODE_CPU_GOVERNOR
	bool "CPU governor optimization"
	default y
	help
	  Request CPU governor change to performance mode.

config GAMEMODE_GPU_OPTIMIZATION
	bool "GPU optimization"
	default y
	help
	  Request GPU clock/power optimizations.

config GAMEMODE_IO_PRIORITY
	bool "I/O priority boost"
	default y
	help
	  Request I/O priority boost for game process.

config GAMEMODE_PROCESS_NICE
	bool "Process nice value"
	default y
	help
	  Request lower nice value for game process.

config GAMEMODE_SCHEDULER
	bool "Scheduler optimization"
	default y
	help
	  Request scheduler optimizations (SCHED_ISO if available).

endmenu

menu "Integration"

config GAMEMODE_DBUS
	bool "D-Bus integration"
	default y
	help
	  Use D-Bus to communicate with gamemoded.

config GAMEMODE_FALLBACK_LIB
	bool "Fallback to library call"
	default y
	help
	  Fall back to direct library calls if D-Bus fails.

endmenu

endif # GAMEMODE

