	"testPresets": [
		{
			"name": "base",
			"hidden": true,
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error"
			},
			"filter": {
				"exclude": {
					"name": "^example64|example$"
				}
			}
		},
		{
			"name": "linux",
			"displayName": "Linux",
			"inherits": [
				"base"
			],
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"configurePreset": "linux"
		},
		{
			"name": "macos",
			"displayName": "macOS",
			"inherits": [
				"base"
			],
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			},
			"configurePreset": "macos"
		},
		{
