# qdcss - Makefile
#
# Build rules for Qt CSS parsing library.

# Library name
lib := qdcss

# Source files
lib-y := src/qdcss.o

# Include paths
includes-y := qdcss/include qdcss/src

# Qt dependencies
qt-modules-y := Core

# Compiler flags
cxxflags-y := $(QT_CFLAGS)
