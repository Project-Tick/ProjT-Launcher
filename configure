#!/bin/bash
# ============================================================================
# ProjT-Launcher Configure Script
# ============================================================================
#
# This script detects system dependencies and generates a .config file.
# Similar to zlib/configure - scans for toolchain, Qt, and libraries.
#
# Usage:
#   ./configure [OPTIONS]
#
# Options:
#   --prefix=DIR          Install prefix (default: /usr/local)
#   --build=TYPE          Build type: debug, release, relwithdebinfo (default: release)
#   --platform=PLATFORM   Target platform: linux, macos, windows (auto-detected)
#   --arch=ARCH           Target architecture (auto-detected)
#   --qt-prefix=PATH      Qt installation prefix (auto-detected)
#   --static              Build static executable
#   --shared              Build shared libraries (default)
#   --with-lto            Enable Link-Time Optimization
#   --without-lto         Disable LTO
#   --with-tests          Enable test building
#   --without-tests       Disable tests (default)
#   --with-gamemode       Enable GameMode support (Linux only)
#   --without-gamemode    Disable GameMode
#   --with-mangohud       Enable MangoHud support (Linux only)
#   --without-mangohud    Disable MangoHud
#   --cc=CC               C compiler
#   --cxx=CXX             C++ compiler
#   --help                Show this help
#
# Environment Variables:
#   CC, CXX               Compiler overrides
#   CFLAGS, CXXFLAGS      Extra compiler flags
#   LDFLAGS               Extra linker flags
#   QT_PREFIX, Qt6_DIR    Qt installation path
#
# Examples:
#   ./configure
#   ./configure --build=release --with-lto
#   ./configure --prefix=/opt/projt --qt-prefix=/opt/qt/6.8.0
#   ./configure --platform=windows --cc=x86_64-w64-mingw32-gcc
#
# ============================================================================

set -e

# Script version
CONFIGURE_VERSION="1.0.0"

# ============================================================================
# Default Values
# ============================================================================

PREFIX="/usr/local"
BUILD_TYPE="release"
PLATFORM=""
ARCH=""
QT_PREFIX=""
QT_SYSTEM=""
STATIC_BUILD="n"
LTO_ENABLED="y"
TESTS_ENABLED="n"
WEBENGINE_ENABLED=""
GAMEMODE_ENABLED=""
MANGOHUD_ENABLED=""
TOOLCHAIN=""
CC_OVERRIDE=""
CXX_OVERRIDE=""
OUTPUT_DIR="build"

# Dependency status
HAVE_CC="n"
HAVE_CXX="n"
HAVE_QT="n"
HAVE_ZLIB="n"
HAVE_LIBPNG="n"
HAVE_BZIP2="n"
HAVE_OPENSSL="n"
HAVE_ZSTD="n"
HAVE_GAMEMODE="n"
HAVE_MANGOHUD="n"
HAVE_DBUS="n"
HAVE_XCB="n"
HAVE_WAYLAND="n"

# Detected versions
QT_VERSION=""
QT_VERSION_MAJOR=""
ZLIB_VERSION=""
OPENSSL_VERSION=""
GCC_VERSION=""
CLANG_VERSION=""

# ============================================================================
# Colors
# ============================================================================

if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    CYAN=''
    BOLD=''
    NC=''
fi

# ============================================================================
# Helper Functions
# ============================================================================

log() {
    echo -e "$@"
}

log_check() {
    printf "checking %s... " "$1"
}

log_result() {
    echo -e "$1"
}

log_yes() {
    echo -e "${GREEN}yes${NC}"
}

log_no() {
    echo -e "${RED}no${NC}"
}

log_found() {
    echo -e "${GREEN}$1${NC}"
}

log_notfound() {
    echo -e "${YELLOW}not found${NC}"
}

log_error() {
    echo -e "${RED}error:${NC} $*" >&2
}

log_warn() {
    echo -e "${YELLOW}warning:${NC} $*" >&2
}

die() {
    log_error "$@"
    exit 1
}

show_help() {
    head -50 "$0" | tail -45 | sed 's/^# //' | sed 's/^#//'
    exit 0
}

show_version() {
    echo "ProjT-Launcher configure $CONFIGURE_VERSION"
    exit 0
}

# Check if a command exists
have_cmd() {
    command -v "$1" >/dev/null 2>&1
}

# Try to compile a test program
try_compile() {
    local cc="${1:-$CC}"
    local src="$2"
    local flags="${3:-}"
    local tmpdir=$(mktemp -d)
    local result=1
    
    echo "$src" > "$tmpdir/test.c"
    if $cc $flags -o "$tmpdir/test" "$tmpdir/test.c" >/dev/null 2>&1; then
        result=0
    fi
    rm -rf "$tmpdir"
    return $result
}

# Try to compile a C++ test program
try_compile_cxx() {
    local cxx="${1:-$CXX}"
    local src="$2"
    local flags="${3:-}"
    local tmpdir=$(mktemp -d)
    local result=1
    
    echo "$src" > "$tmpdir/test.cpp"
    if $cxx $flags -o "$tmpdir/test" "$tmpdir/test.cpp" >/dev/null 2>&1; then
        result=0
    fi
    rm -rf "$tmpdir"
    return $result
}

# Run pkg-config
pkg_config() {
    pkg-config "$@" 2>/dev/null
}

# ============================================================================
# Parse Arguments
# ============================================================================

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --prefix=*)     PREFIX="${1#*=}" ;;
            --build=*)      BUILD_TYPE="${1#*=}" ;;
            --build-type=*) BUILD_TYPE="${1#*=}" ;;
            --platform=*)   PLATFORM="${1#*=}" ;;
            --target=*)     PLATFORM="${1#*=}" ;;
            --arch=*)       ARCH="${1#*=}" ;;
            --qt-prefix=*)  QT_PREFIX="${1#*=}" ;;
            --qt-path=*)    QT_PREFIX="${1#*=}" ;;
            --qt-system)    QT_SYSTEM="y" ;;
            --static)       STATIC_BUILD="y" ;;
            --shared)       STATIC_BUILD="n" ;;
            --with-lto)     LTO_ENABLED="y" ;;
            --without-lto)  LTO_ENABLED="n" ;;
            --enable-lto)   LTO_ENABLED="y" ;;
            --disable-lto)  LTO_ENABLED="n" ;;
            --with-tests)   TESTS_ENABLED="y" ;;
            --without-tests) TESTS_ENABLED="n" ;;
            --enable-tests) TESTS_ENABLED="y" ;;
            --disable-tests) TESTS_ENABLED="n" ;;
            --enable-webengine) WEBENGINE_ENABLED="y" ;;
            --disable-webengine) WEBENGINE_ENABLED="n" ;;
            --with-gamemode) GAMEMODE_ENABLED="y" ;;
            --without-gamemode) GAMEMODE_ENABLED="n" ;;
            --with-mangohud) MANGOHUD_ENABLED="y" ;;
            --without-mangohud) MANGOHUD_ENABLED="n" ;;
            --toolchain=*)  TOOLCHAIN="${1#*=}" ;;
            --cc=*)         CC_OVERRIDE="${1#*=}" ;;
            --cxx=*)        CXX_OVERRIDE="${1#*=}" ;;
            --output=*)     OUTPUT_DIR="${1#*=}" ;;
            -h|--help)      show_help ;;
            -V|--version)   show_version ;;
            *)              log_warn "unknown option: $1" ;;
        esac
        shift
    done
}

# ============================================================================
# Platform Detection
# ============================================================================

detect_platform() {
    if [ -n "$PLATFORM" ]; then
        return
    fi
    
    log_check "host system type"
    
    case "$(uname -s)" in
        Linux*)     PLATFORM="linux" ;;
        Darwin*)    PLATFORM="macos" ;;
        CYGWIN*|MINGW*|MSYS*) PLATFORM="windows" ;;
        FreeBSD*)   PLATFORM="freebsd" ;;
        OpenBSD*)   PLATFORM="openbsd" ;;
        NetBSD*)    PLATFORM="netbsd" ;;
        *)          PLATFORM="unknown" ;;
    esac
    
    log_result "$PLATFORM"
}

detect_arch() {
    if [ -n "$ARCH" ]; then
        return
    fi
    
    log_check "host architecture"
    
    case "$(uname -m)" in
        x86_64|amd64)   ARCH="x86_64" ;;
        aarch64|arm64)  ARCH="aarch64" ;;
        armv7l|armhf)   ARCH="arm" ;;
        i686|i386)      ARCH="x86" ;;
        riscv64)        ARCH="riscv64" ;;
        ppc64le)        ARCH="ppc64le" ;;
        s390x)          ARCH="s390x" ;;
        *)              ARCH="$(uname -m)" ;;
    esac
    
    log_result "$ARCH"
}

# ============================================================================
# Toolchain Detection
# ============================================================================

detect_cc() {
    log_check "for C compiler"
    
    # Use override if specified
    if [ -n "$CC_OVERRIDE" ]; then
        CC="$CC_OVERRIDE"
    elif [ -n "$CC" ]; then
        : # Use environment CC
    else
        # Try to find a C compiler
        for cc in clang gcc cc; do
            if have_cmd "$cc"; then
                CC="$cc"
                break
            fi
        done
    fi
    
    if [ -z "$CC" ]; then
        log_notfound
        return
    fi
    
    # Verify it works
    if try_compile "$CC" "int main(){return 0;}"; then
        HAVE_CC="y"
        
        # Get version
        local version=$($CC --version 2>/dev/null | head -1)
        if echo "$version" | grep -qi "clang"; then
            CLANG_VERSION=$(echo "$version" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            log_found "$CC (clang $CLANG_VERSION)"
        elif echo "$version" | grep -qi "gcc"; then
            GCC_VERSION=$(echo "$version" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            log_found "$CC (gcc $GCC_VERSION)"
        else
            log_found "$CC"
        fi
    else
        log_no
    fi
}

detect_cxx() {
    log_check "for C++ compiler"
    
    # Use override if specified
    if [ -n "$CXX_OVERRIDE" ]; then
        CXX="$CXX_OVERRIDE"
    elif [ -n "$CXX" ]; then
        : # Use environment CXX
    else
        # Try to find a C++ compiler
        for cxx in clang++ g++ c++; do
            if have_cmd "$cxx"; then
                CXX="$cxx"
                break
            fi
        done
    fi
    
    if [ -z "$CXX" ]; then
        log_notfound
        return
    fi
    
    # Verify it works with C++17
    if try_compile_cxx "$CXX" "#include <optional>
int main(){std::optional<int> x;return 0;}" "-std=c++17"; then
        HAVE_CXX="y"
        log_found "$CXX"
    else
        log_no
    fi
}

detect_cxx_standard() {
    log_check "for C++23 support"
    
    if try_compile_cxx "$CXX" "#include <print>
int main(){return 0;}" "-std=c++23"; then
        CXX_STD="23"
        log_yes
        return
    fi
    log_no
    
    log_check "for C++20 support"
    if try_compile_cxx "$CXX" "#include <concepts>
int main(){return 0;}" "-std=c++20"; then
        CXX_STD="20"
        log_yes
        return
    fi
    log_no
    
    log_check "for C++17 support"
    if try_compile_cxx "$CXX" "#include <optional>
int main(){return 0;}" "-std=c++17"; then
        CXX_STD="17"
        log_yes
        return
    fi
    log_no
    
    CXX_STD="14"
}

# ============================================================================
# Qt Detection
# ============================================================================

detect_qt() {
    log_check "for Qt"
    
    # If explicit path given
    if [ -n "$QT_PREFIX" ]; then
        if [ -f "$QT_PREFIX/bin/qmake" ] || [ -f "$QT_PREFIX/bin/qmake6" ]; then
            HAVE_QT="y"
        fi
    fi
    
    # Try Qt6_DIR environment variable
    if [ "$HAVE_QT" != "y" ] && [ -n "$Qt6_DIR" ]; then
        QT_PREFIX="$Qt6_DIR"
        if [ -d "$QT_PREFIX" ]; then
            HAVE_QT="y"
        fi
    fi
    
    # Try qmake6
    if [ "$HAVE_QT" != "y" ] && have_cmd qmake6; then
        QT_PREFIX=$(qmake6 -query QT_INSTALL_PREFIX 2>/dev/null || true)
        if [ -n "$QT_PREFIX" ]; then
            HAVE_QT="y"
        fi
    fi
    
    # Try qmake
    if [ "$HAVE_QT" != "y" ] && have_cmd qmake; then
        local ver=$(qmake -query QT_VERSION 2>/dev/null || true)
        if [ -n "$ver" ] && [ "${ver%%.*}" -ge 6 ]; then
            QT_PREFIX=$(qmake -query QT_INSTALL_PREFIX 2>/dev/null || true)
            if [ -n "$QT_PREFIX" ]; then
                HAVE_QT="y"
            fi
        fi
    fi
    
    # Try pkg-config
    if [ "$HAVE_QT" != "y" ]; then
        if pkg_config --exists Qt6Core; then
            QT_PREFIX=$(pkg_config --variable=prefix Qt6Core)
            HAVE_QT="y"
        fi
    fi
    
    # Try common paths
    if [ "$HAVE_QT" != "y" ]; then
        local qt_search_paths=(
            "/usr/lib64/qt6"
            "/usr/lib/qt6"
            "/usr/local/qt6"
            "/opt/qt6"
            "$HOME/Qt/*/gcc_64"
            "$HOME/Qt/*/clang_64"
            "/opt/Qt/*/gcc_64"
            "/opt/Qt/*/clang_64"
        )
        
        for pattern in "${qt_search_paths[@]}"; do
            for path in $pattern; do
                if [ -d "$path" ] && [ -f "$path/bin/qmake" -o -f "$path/bin/qmake6" ]; then
                    QT_PREFIX="$path"
                    HAVE_QT="y"
                    break 2
                fi
            done
        done
    fi
    
    # Get version
    if [ "$HAVE_QT" = "y" ]; then
        if [ -x "$QT_PREFIX/bin/qmake6" ]; then
            QT_VERSION=$("$QT_PREFIX/bin/qmake6" -query QT_VERSION 2>/dev/null || true)
        elif [ -x "$QT_PREFIX/bin/qmake" ]; then
            QT_VERSION=$("$QT_PREFIX/bin/qmake" -query QT_VERSION 2>/dev/null || true)
        elif have_cmd qmake6; then
            QT_VERSION=$(qmake6 -query QT_VERSION 2>/dev/null || true)
        elif have_cmd qmake; then
            QT_VERSION=$(qmake -query QT_VERSION 2>/dev/null || true)
        fi
        
        if [ -n "$QT_VERSION" ]; then
            QT_VERSION_MAJOR="${QT_VERSION%%.*}"
            log_found "$QT_VERSION ($QT_PREFIX)"
        else
            log_found "$QT_PREFIX"
        fi
    else
        log_notfound
    fi
}

# ============================================================================
# Library Detection
# ============================================================================

detect_zlib() {
    log_check "for zlib"
    
    if pkg_config --exists zlib; then
        HAVE_ZLIB="y"
        ZLIB_VERSION=$(pkg_config --modversion zlib)
        log_found "$ZLIB_VERSION"
    elif try_compile "$CC" '#include <zlib.h>
int main(){deflate(0,0);return 0;}' "-lz"; then
        HAVE_ZLIB="y"
        log_yes
    else
        # We have bundled zlib
        log_result "${YELLOW}bundled${NC}"
    fi
}

detect_libpng() {
    log_check "for libpng"
    
    if pkg_config --exists libpng; then
        HAVE_LIBPNG="y"
        log_found "$(pkg_config --modversion libpng)"
    elif try_compile "$CC" '#include <png.h>
int main(){png_create_read_struct(0,0,0,0);return 0;}' "-lpng"; then
        HAVE_LIBPNG="y"
        log_yes
    else
        log_result "${YELLOW}bundled${NC}"
    fi
}

detect_bzip2() {
    log_check "for bzip2"
    
    if pkg_config --exists bzip2; then
        HAVE_BZIP2="y"
        log_found "$(pkg_config --modversion bzip2)"
    elif try_compile "$CC" '#include <bzlib.h>
int main(){BZ2_bzCompress(0,0);return 0;}' "-lbz2"; then
        HAVE_BZIP2="y"
        log_yes
    else
        log_result "${YELLOW}bundled${NC}"
    fi
}

detect_openssl() {
    log_check "for OpenSSL"
    
    if pkg_config --exists openssl; then
        HAVE_OPENSSL="y"
        OPENSSL_VERSION=$(pkg_config --modversion openssl)
        log_found "$OPENSSL_VERSION"
    elif try_compile "$CC" '#include <openssl/ssl.h>
int main(){SSL_library_init();return 0;}' "-lssl -lcrypto"; then
        HAVE_OPENSSL="y"
        log_yes
    else
        log_notfound
    fi
}

detect_zstd() {
    log_check "for zstd"
    
    if pkg_config --exists libzstd; then
        HAVE_ZSTD="y"
        log_found "$(pkg_config --modversion libzstd)"
    elif try_compile "$CC" '#include <zstd.h>
int main(){ZSTD_compress(0,0,0,0,0);return 0;}' "-lzstd"; then
        HAVE_ZSTD="y"
        log_yes
    else
        log_notfound
    fi
}

# ============================================================================
# Platform-Specific Detection (Linux)
# ============================================================================

detect_linux_deps() {
    if [ "$PLATFORM" != "linux" ]; then
        return
    fi
    
    # D-Bus
    log_check "for D-Bus"
    if pkg_config --exists dbus-1; then
        HAVE_DBUS="y"
        log_found "$(pkg_config --modversion dbus-1)"
    else
        log_notfound
    fi
    
    # XCB
    log_check "for XCB"
    if pkg_config --exists xcb; then
        HAVE_XCB="y"
        log_found "$(pkg_config --modversion xcb)"
    else
        log_notfound
    fi
    
    # Wayland
    log_check "for Wayland"
    if pkg_config --exists wayland-client; then
        HAVE_WAYLAND="y"
        log_found "$(pkg_config --modversion wayland-client)"
    else
        log_notfound
    fi
    
    # GameMode
    log_check "for GameMode"
    if pkg_config --exists gamemode; then
        HAVE_GAMEMODE="y"
        log_found "$(pkg_config --modversion gamemode)"
    elif [ -f "/usr/include/gamemode_client.h" ]; then
        HAVE_GAMEMODE="y"
        log_yes
    else
        log_notfound
    fi
    
    # MangoHud (check for mangohud binary)
    log_check "for MangoHud"
    if have_cmd mangohud; then
        HAVE_MANGOHUD="y"
        log_yes
    else
        log_notfound
    fi
}

# ============================================================================
# Generate Configuration
# ============================================================================

generate_config() {
    local config_file="$OUTPUT_DIR/.config"
    
    log ""
    log "${BOLD}Generating configuration...${NC}"
    
    mkdir -p "$OUTPUT_DIR"
    
    cat > "$config_file" << EOF
# ============================================================================
# ProjT-Launcher Configuration
# Generated by configure on $(date)
# ============================================================================

# Build Type
EOF

    case "$BUILD_TYPE" in
        debug)
            echo "CONFIG_BUILD_DEBUG=y" >> "$config_file"
            echo "# CONFIG_BUILD_RELEASE is not set" >> "$config_file"
            echo "# CONFIG_BUILD_RELWITHDEBINFO is not set" >> "$config_file"
            ;;
        relwithdebinfo)
            echo "# CONFIG_BUILD_DEBUG is not set" >> "$config_file"
            echo "# CONFIG_BUILD_RELEASE is not set" >> "$config_file"
            echo "CONFIG_BUILD_RELWITHDEBINFO=y" >> "$config_file"
            ;;
        *)
            echo "# CONFIG_BUILD_DEBUG is not set" >> "$config_file"
            echo "CONFIG_BUILD_RELEASE=y" >> "$config_file"
            echo "# CONFIG_BUILD_RELWITHDEBINFO is not set" >> "$config_file"
            ;;
    esac

    cat >> "$config_file" << EOF

# Target Platform
EOF

    case "$PLATFORM" in
        linux)
            echo "CONFIG_TARGET_LINUX=y" >> "$config_file"
            echo "# CONFIG_TARGET_WINDOWS is not set" >> "$config_file"
            echo "# CONFIG_TARGET_MACOS is not set" >> "$config_file"
            ;;
        windows)
            echo "# CONFIG_TARGET_LINUX is not set" >> "$config_file"
            echo "CONFIG_TARGET_WINDOWS=y" >> "$config_file"
            echo "# CONFIG_TARGET_MACOS is not set" >> "$config_file"
            ;;
        macos)
            echo "# CONFIG_TARGET_LINUX is not set" >> "$config_file"
            echo "# CONFIG_TARGET_WINDOWS is not set" >> "$config_file"
            echo "CONFIG_TARGET_MACOS=y" >> "$config_file"
            ;;
    esac

    cat >> "$config_file" << EOF

# Architecture
CONFIG_ARCH_AUTO=y
EOF

    case "$ARCH" in
        x86_64)  echo "CONFIG_ARCH_X86_64=y" >> "$config_file" ;;
        aarch64) echo "CONFIG_ARCH_AARCH64=y" >> "$config_file" ;;
        arm)     echo "CONFIG_ARCH_ARM=y" >> "$config_file" ;;
        x86)     echo "CONFIG_ARCH_X86=y" >> "$config_file" ;;
    esac

    cat >> "$config_file" << EOF

# Optimization
CONFIG_OPT_O2=y
EOF

    if [ "$LTO_ENABLED" = "y" ]; then
        echo "CONFIG_LTO=y" >> "$config_file"
        echo "CONFIG_LTO_THIN=y" >> "$config_file"
    else
        echo "# CONFIG_LTO is not set" >> "$config_file"
    fi

    cat >> "$config_file" << EOF

# Toolchain - System (auto-detected)
CONFIG_TOOLCHAIN_AUTO=y
# CONFIG_BOOTSTRAP_TOOLCHAIN is not set
# CONFIG_TOOLCHAIN_BUNDLED_GCC is not set
# CONFIG_TOOLCHAIN_BUNDLED_LLVM is not set
EOF

    if [ -n "$CC" ]; then
        echo "CONFIG_CC=\"$CC\"" >> "$config_file"
    else
        echo "CONFIG_CC=\"\"" >> "$config_file"
    fi
    
    if [ -n "$CXX" ]; then
        echo "CONFIG_CXX=\"$CXX\"" >> "$config_file"
    else
        echo "CONFIG_CXX=\"\"" >> "$config_file"
    fi

    cat >> "$config_file" << EOF

# C++ Standard
EOF
    case "$CXX_STD" in
        23) echo "CONFIG_CPP_STD_23=y" >> "$config_file" ;;
        20) echo "CONFIG_CPP_STD_20=y" >> "$config_file" ;;
        17) echo "CONFIG_CPP_STD_17=y" >> "$config_file" ;;
        *)  echo "CONFIG_CPP_STD_17=y" >> "$config_file" ;;
    esac

    cat >> "$config_file" << EOF

# Qt - System (auto-detected)
CONFIG_QT_SYSTEM=y
# CONFIG_QT_BUNDLED is not set
# CONFIG_QT_DOWNLOAD is not set
EOF

    if [ -n "$QT_PREFIX" ]; then
        echo "CONFIG_QT_PREFIX=\"$QT_PREFIX\"" >> "$config_file"
    else
        echo "CONFIG_QT_PREFIX=\"\"" >> "$config_file"
    fi

    if [ -n "$QT_VERSION" ]; then
        local major="${QT_VERSION%%.*}"
        local rest="${QT_VERSION#*.}"
        local minor="${rest%%.*}"
        local patch="${rest#*.}"
        patch="${patch%%.*}"
        
        echo "CONFIG_QT_VERSION_MAJOR=$major" >> "$config_file"
        echo "CONFIG_QT_VERSION_MINOR=$minor" >> "$config_file"
        echo "CONFIG_QT_VERSION_PATCH=$patch" >> "$config_file"
    fi

    if [ "$STATIC_BUILD" = "y" ]; then
        echo "CONFIG_QT_STATIC=y" >> "$config_file"
        echo "# CONFIG_QT_SHARED is not set" >> "$config_file"
    else
        echo "# CONFIG_QT_STATIC is not set" >> "$config_file"
        echo "CONFIG_QT_SHARED=y" >> "$config_file"
    fi

    cat >> "$config_file" << EOF

# Qt Platform Plugins
EOF

    case "$PLATFORM" in
        linux)
            [ "$HAVE_XCB" = "y" ] && echo "CONFIG_QT_PLATFORM_XCB=y" >> "$config_file"
            [ "$HAVE_WAYLAND" = "y" ] && echo "CONFIG_QT_PLATFORM_WAYLAND=y" >> "$config_file"
            ;;
        macos)
            echo "CONFIG_QT_PLATFORM_COCOA=y" >> "$config_file"
            ;;
        windows)
            echo "CONFIG_QT_PLATFORM_WINDOWS=y" >> "$config_file"
            ;;
    esac

    cat >> "$config_file" << EOF

# Qt Features
CONFIG_QT_FEATURE_CONCURRENT=y
CONFIG_QT_FEATURE_XML=y
CONFIG_QT_FEATURE_OPENGL=y
EOF
    [ "$HAVE_OPENSSL" = "y" ] && echo "CONFIG_QT_FEATURE_OPENSSL=y" >> "$config_file"
    [ "$HAVE_ZSTD" = "y" ] && echo "CONFIG_QT_FEATURE_ZSTD=y" >> "$config_file"

    cat >> "$config_file" << EOF
CONFIG_QT_FEATURE_ACCESSIBILITY=y
CONFIG_QT_FEATURE_WIDGETS=y

# Features
CONFIG_FEATURE_LAUNCHER_APPLICATION=y
CONFIG_FEATURE_LAUNCHER_UI=y
CONFIG_FEATURE_META=y
CONFIG_FEATURE_JAVA=y
CONFIG_FEATURE_JAVA_DOWNLOADER=y
CONFIG_FEATURE_JAVA_CHECK=y
CONFIG_FEATURE_LAUNCHER_HUB=y
# CONFIG_FEATURE_WEBENGINE is not set
CONFIG_FEATURE_UPDATER=y
CONFIG_FEATURE_NEWS=y
CONFIG_FEATURE_ANALYTICS=y
CONFIG_FEATURE_SKINS=y
CONFIG_FEATURE_MODPACKS=y
CONFIG_FEATURE_CURSE=y
CONFIG_FEATURE_MODRINTH=y
CONFIG_FEATURE_TECHNIC=y
CONFIG_FEATURE_ATL=y
CONFIG_FEATURE_FTB=y
CONFIG_FEATURE_FLAME=y
CONFIG_FEATURE_QRCODE=y
CONFIG_FEATURE_DISCORD=y
EOF

    # GameMode (Linux only)
    if [ "$PLATFORM" = "linux" ]; then
        if [ "$GAMEMODE_ENABLED" = "y" ] || { [ -z "$GAMEMODE_ENABLED" ] && [ "$HAVE_GAMEMODE" = "y" ]; }; then
            echo "CONFIG_FEATURE_GAMEMODE=y" >> "$config_file"
        else
            echo "# CONFIG_FEATURE_GAMEMODE is not set" >> "$config_file"
        fi
        
        if [ "$MANGOHUD_ENABLED" = "y" ] || { [ -z "$MANGOHUD_ENABLED" ] && [ "$HAVE_MANGOHUD" = "y" ]; }; then
            echo "CONFIG_FEATURE_MANGOHUD=y" >> "$config_file"
        else
            echo "# CONFIG_FEATURE_MANGOHUD is not set" >> "$config_file"
        fi
    else
        echo "# CONFIG_FEATURE_GAMEMODE is not set" >> "$config_file"
        echo "# CONFIG_FEATURE_MANGOHUD is not set" >> "$config_file"
    fi

    echo "CONFIG_FEATURE_CMARK=y" >> "$config_file"

    cat >> "$config_file" << EOF

# Modules - Build all
CONFIG_MOD_LAUNCHER=y
CONFIG_MOD_BUILD_CONFIG=y
CONFIG_MOD_PROGRAM_INFO=y
CONFIG_MOD_SYSTEMINFO=y
CONFIG_MOD_LAUNCHERJAVA=y
CONFIG_MOD_JAVACHECK=y
CONFIG_MOD_RAINBOW=y
CONFIG_MOD_LOCALPEER=y
EOF

    if [ "$PLATFORM" = "linux" ] && [ "$HAVE_GAMEMODE" = "y" ]; then
        echo "CONFIG_MOD_GAMEMODE=y" >> "$config_file"
    else
        echo "# CONFIG_MOD_GAMEMODE is not set" >> "$config_file"
    fi

    cat >> "$config_file" << EOF
CONFIG_MOD_MURMUR2=y
CONFIG_MOD_QDCSS=y
CONFIG_MOD_ZLIB=y
CONFIG_MOD_LIBPNG=y
CONFIG_MOD_BZIP2=y
CONFIG_MOD_MINIZIP=y
CONFIG_MOD_QUAZIP=y
CONFIG_MOD_TOMLPLUSPLUS=y
CONFIG_MOD_CMARK=y
CONFIG_MOD_LIBQRENCODE=y
CONFIG_MOD_LIBNBTPLUSPLUS=y

# Testing
EOF

    if [ "$TESTS_ENABLED" = "y" ]; then
        echo "CONFIG_BUILD_TESTS=y" >> "$config_file"
    else
        echo "# CONFIG_BUILD_TESTS is not set" >> "$config_file"
    fi

    cat >> "$config_file" << EOF
# CONFIG_BUILD_FUZZERS is not set
# CONFIG_BUILD_BENCHMARKS is not set

# Installation
CONFIG_INSTALL_PREFIX="$PREFIX"
CONFIG_INSTALL_BINDIR="bin"
CONFIG_INSTALL_LIBDIR="lib"
CONFIG_INSTALL_DATADIR="share"
EOF

    log "Configuration written to ${CYAN}$config_file${NC}"
}

# ============================================================================
# Summary
# ============================================================================

print_summary() {
    log ""
    log "${BOLD}=== Configuration Summary ===${NC}"
    log ""
    log "Platform:      $PLATFORM ($ARCH)"
    log "Build type:    $BUILD_TYPE"
    log "Install prefix: $PREFIX"
    log ""
    log "${BOLD}Toolchain:${NC}"
    if [ "$HAVE_CC" = "y" ]; then
        log "  C compiler:   ${GREEN}$CC${NC}"
    else
        log "  C compiler:   ${RED}not found${NC}"
    fi
    if [ "$HAVE_CXX" = "y" ]; then
        log "  C++ compiler: ${GREEN}$CXX${NC}"
    else
        log "  C++ compiler: ${RED}not found${NC}"
    fi
    log "  C++ standard: C++$CXX_STD"
    log ""
    log "${BOLD}Qt:${NC}"
    if [ "$HAVE_QT" = "y" ]; then
        log "  Version:      ${GREEN}$QT_VERSION${NC}"
        log "  Prefix:       $QT_PREFIX"
    else
        log "  Status:       ${RED}not found${NC}"
    fi
    log ""
    log "${BOLD}Libraries:${NC}"
    if [ "$HAVE_ZLIB" = "y" ]; then
        log "  zlib:         ${GREEN}system${NC}"
    else
        log "  zlib:         ${YELLOW}bundled${NC}"
    fi
    if [ "$HAVE_LIBPNG" = "y" ]; then
        log "  libpng:       ${GREEN}system${NC}"
    else
        log "  libpng:       ${YELLOW}bundled${NC}"
    fi
    if [ "$HAVE_BZIP2" = "y" ]; then
        log "  bzip2:        ${GREEN}system${NC}"
    else
        log "  bzip2:        ${YELLOW}bundled${NC}"
    fi
    if [ "$HAVE_OPENSSL" = "y" ]; then
        log "  OpenSSL:      ${GREEN}yes${NC}"
    else
        log "  OpenSSL:      ${RED}no${NC}"
    fi
    if [ "$HAVE_ZSTD" = "y" ]; then
        log "  zstd:         ${GREEN}yes${NC}"
    else
        log "  zstd:         ${RED}no${NC}"
    fi
    
    if [ "$PLATFORM" = "linux" ]; then
        log ""
        log "${BOLD}Linux Features:${NC}"
        if [ "$HAVE_DBUS" = "y" ]; then
            log "  D-Bus:        ${GREEN}yes${NC}"
        else
            log "  D-Bus:        ${RED}no${NC}"
        fi
        if [ "$HAVE_XCB" = "y" ]; then
            log "  XCB:          ${GREEN}yes${NC}"
        else
            log "  XCB:          ${RED}no${NC}"
        fi
        if [ "$HAVE_WAYLAND" = "y" ]; then
            log "  Wayland:      ${GREEN}yes${NC}"
        else
            log "  Wayland:      ${RED}no${NC}"
        fi
        if [ "$HAVE_GAMEMODE" = "y" ]; then
            log "  GameMode:     ${GREEN}yes${NC}"
        else
            log "  GameMode:     ${RED}no${NC}"
        fi
        if [ "$HAVE_MANGOHUD" = "y" ]; then
            log "  MangoHud:     ${GREEN}yes${NC}"
        else
            log "  MangoHud:     ${RED}no${NC}"
        fi
    fi
    
    log ""
    log "${BOLD}Options:${NC}"
    if [ "$LTO_ENABLED" = "y" ]; then
        log "  LTO:          ${GREEN}yes${NC}"
    else
        log "  LTO:          ${YELLOW}no${NC}"
    fi
    if [ "$STATIC_BUILD" = "y" ]; then
        log "  Static:       ${GREEN}yes${NC}"
    else
        log "  Static:       ${YELLOW}no${NC}"
    fi
    if [ "$TESTS_ENABLED" = "y" ]; then
        log "  Tests:        ${GREEN}yes${NC}"
    else
        log "  Tests:        ${YELLOW}no${NC}"
    fi
    log ""
    
    # Warnings
    if [ "$HAVE_CC" != "y" ] || [ "$HAVE_CXX" != "y" ]; then
        log_warn "No working compiler found!"
    fi
    
    if [ "$HAVE_QT" != "y" ]; then
        log_warn "Qt not found. Use --qt-prefix=PATH or install Qt 6."
    fi
    
    log ""
    log "Now run: ${CYAN}make${NC}"
}

# ============================================================================
# Main
# ============================================================================

main() {
    log "${BOLD}ProjT-Launcher configure${NC}"
    log ""
    
    parse_args "$@"
    
    detect_platform
    detect_arch
    
    log ""
    detect_cc
    detect_cxx
    detect_cxx_standard
    
    log ""
    detect_qt
    
    log ""
    detect_zlib
    detect_libpng
    detect_bzip2
    detect_openssl
    detect_zstd
    
    detect_linux_deps
    
    generate_config
    print_summary
}

main "$@"
