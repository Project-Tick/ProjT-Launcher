# Kconfig - CommonMark Markdown parser
# Included from main Kconfig

menuconfig CMARK
	bool "cmark - CommonMark parser"
	default y
	help
	  CommonMark-compliant Markdown parser and renderer.
	  Used for news display and documentation rendering.

if CMARK

config CMARK_VERSION
	string "cmark version"
	default "0.31.1"

config CMARK_STATIC
	bool "Build as static library"
	default y
	help
	  Build cmark as a static library.

config CMARK_SHARED
	bool "Build as shared library"
	default n
	help
	  Also build cmark as a shared library.

menu "Extensions"

config CMARK_GFM_EXTENSIONS
	bool "GitHub Flavored Markdown extensions"
	default y
	help
	  Enable GFM extensions: tables, autolinks, strikethrough, etc.

config CMARK_EXT_TABLE
	bool "Table extension"
	default y
	depends on CMARK_GFM_EXTENSIONS
	help
	  GFM-style table support.

config CMARK_EXT_STRIKETHROUGH
	bool "Strikethrough extension"
	default y
	depends on CMARK_GFM_EXTENSIONS
	help
	  ~~strikethrough~~ text support.

config CMARK_EXT_AUTOLINK
	bool "Autolink extension"
	default y
	depends on CMARK_GFM_EXTENSIONS
	help
	  Automatically convert URLs to links.

config CMARK_EXT_TAGFILTER
	bool "Tag filter extension"
	default y
	depends on CMARK_GFM_EXTENSIONS
	help
	  Filter dangerous HTML tags.

config CMARK_EXT_TASKLIST
	bool "Task list extension"
	default y
	depends on CMARK_GFM_EXTENSIONS
	help
	  GitHub-style task list checkboxes.

endmenu

menu "Rendering"

config CMARK_RENDER_HTML
	bool "HTML rendering"
	default y
	help
	  Enable HTML output rendering.

config CMARK_RENDER_XML
	bool "XML rendering"
	default n
	help
	  Enable XML output rendering.

config CMARK_RENDER_MAN
	bool "Man page rendering"
	default n
	help
	  Enable man page output rendering.

config CMARK_RENDER_COMMONMARK
	bool "CommonMark rendering"
	default n
	help
	  Enable CommonMark (normalized) output.

config CMARK_RENDER_LATEX
	bool "LaTeX rendering"
	default n
	help
	  Enable LaTeX output rendering.

endmenu

menu "Safety"

config CMARK_SAFE
	bool "Safe mode"
	default y
	help
	  Enable safe mode which sanitizes raw HTML and URLs.

config CMARK_VALIDATE_UTF8
	bool "Validate UTF-8 input"
	default y
	help
	  Validate that input is valid UTF-8.

endmenu

config CMARK_TESTS
	bool "Build tests"
	default n
	depends on BUILD_TESTS

endif # CMARK

