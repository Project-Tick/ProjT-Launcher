# SPDX-License-Identifier: GPL-2.0
# ProjT Launcher - Default Configuration
#
# This is the default configuration for ProjT Launcher.
# Generated for general use on all platforms.

#
# Build Settings
#
CONFIG_BUILD_TYPE="Debug"
# CONFIG_OPT_DEFAULT is not set
# CONFIG_OPT_O0 is not set
# CONFIG_OPT_O1 is not set
CONFIG_OPT_O2=y
# CONFIG_OPT_O3 is not set
# CONFIG_OPT_OS is not set
# CONFIG_OPT_OZ is not set
# CONFIG_OPT_OFAST is not set
# CONFIG_ENABLE_LTO is not set
# CONFIG_ENABLE_PGO is not set
CONFIG_DEBUG_SYMBOLS=y
# CONFIG_STRIP_BINARY is not set
# CONFIG_STATIC_LINK is not set
# CONFIG_SANITIZERS is not set

#
# Target Platform
#
CONFIG_TARGET_AUTO=y
# CONFIG_TARGET_LINUX is not set
# CONFIG_TARGET_WINDOWS is not set
# CONFIG_TARGET_MACOS is not set
# CONFIG_TARGET_FREEBSD is not set
# CONFIG_TARGET_OPENBSD is not set
# CONFIG_TARGET_NETBSD is not set
# CONFIG_TARGET_ANDROID is not set
# CONFIG_TARGET_IOS is not set
# CONFIG_TARGET_WASM is not set
# CONFIG_TARGET_HAIKU is not set
CONFIG_ARCH_AUTO=y
# CONFIG_ARCH_X86_64 is not set
# CONFIG_ARCH_X86 is not set
# CONFIG_ARCH_AARCH64 is not set
# CONFIG_ARCH_ARM is not set
# CONFIG_ARCH_RISCV64 is not set
# CONFIG_ARCH_RISCV32 is not set
# CONFIG_ARCH_PPC64LE is not set
# CONFIG_ARCH_S390X is not set
# CONFIG_ARCH_LOONGARCH64 is not set
# CONFIG_ARCH_MIPS64 is not set
# CONFIG_ARCH_WASM32 is not set
CONFIG_TARGET_OS=""
CONFIG_TARGET_ARCH=""

#
# Toolchain
#
CONFIG_TOOLCHAIN_AUTO=y
# CONFIG_TOOLCHAIN_GCC is not set
# CONFIG_TOOLCHAIN_CLANG is not set
# CONFIG_TOOLCHAIN_MSVC is not set
# CONFIG_TOOLCHAIN_MINGW is not set
# CONFIG_TOOLCHAIN_APPLE_CLANG is not set
# CONFIG_TOOLCHAIN_ANDROID_NDK is not set
# CONFIG_TOOLCHAIN_EMSCRIPTEN is not set
# CONFIG_TOOLCHAIN_ZIG is not set
CONFIG_CROSS_COMPILE=""
CONFIG_SYSROOT=""
CONFIG_CC=""
CONFIG_CXX=""
CONFIG_AR=""
CONFIG_LD=""
CONFIG_STRIP=""
CONFIG_CFLAGS_EXTRA=""
CONFIG_CXXFLAGS_EXTRA=""
CONFIG_LDFLAGS_EXTRA=""

#
# Toolchain Bootstrap
#
# CONFIG_BOOTSTRAP_TOOLCHAIN is not set

#
# Qt Settings
#
CONFIG_QT_VERSION_MAJOR="6"
CONFIG_QT_PREFIX=""
CONFIG_QT_HOST_BINS=""
# CONFIG_USE_BUNDLED_QT is not set
CONFIG_LAUNCHER_WITH_WEBENGINE=y

#
# Features
#
CONFIG_ENABLE_JAVA_DOWNLOADER=y
CONFIG_ENABLE_UPDATER=y
CONFIG_ENABLE_NEWS=y
CONFIG_ENABLE_DISCORD_RPC=y
CONFIG_ENABLE_GAMEMODE=y
CONFIG_ENABLE_MANGOHUD=y

#
# Modules
#
CONFIG_MOD_LAUNCHER=y
CONFIG_MOD_BUILD_CONFIG=y
CONFIG_MOD_PROGRAM_INFO=y
CONFIG_MOD_SYSTEMINFO=y
CONFIG_MOD_LAUNCHERJAVA=y
CONFIG_MOD_JAVACHECK=y
CONFIG_MOD_RAINBOW=y
CONFIG_MOD_LOCALPEER=y
CONFIG_MOD_GAMEMODE=y
CONFIG_MOD_MURMUR2=y
CONFIG_MOD_QDCSS=y

#
# Bundled Libraries
#
CONFIG_MOD_ZLIB=y
CONFIG_MOD_LIBPNG=y
CONFIG_MOD_BZIP2=y
CONFIG_MOD_MINIZIP=y
CONFIG_MOD_QUAZIP=y
CONFIG_MOD_TOMLPLUSPLUS=y
CONFIG_MOD_JSON=y
CONFIG_MOD_CMARK=y
CONFIG_MOD_LIBQRENCODE=y
CONFIG_MOD_LIBNBTPLUSPLUS=y

#
# Testing and Quality
#
# CONFIG_BUILD_TESTS is not set
# CONFIG_BUILD_FUZZERS is not set
# CONFIG_ENABLE_COVERAGE is not set
# CONFIG_ENABLE_CLANG_TIDY is not set
# CONFIG_ENABLE_IWYU is not set

#
# Packaging
#
CONFIG_PACKAGE_NAME="projtlauncher"
CONFIG_PACKAGE_VERSION="0.0.5.1"
CONFIG_PACKAGE_MAINTAINER="Project Tick <projecttick@projecttick.org>"
# CONFIG_PACKAGE_DEB is not set
# CONFIG_PACKAGE_RPM is not set
CONFIG_PACKAGE_APPIMAGE=y
# CONFIG_PACKAGE_FLATPAK is not set
# CONFIG_PACKAGE_SNAP is not set

#
# Developer Options
#
# CONFIG_VERBOSE_BUILD is not set
CONFIG_CCACHE=y
# CONFIG_DISTCC is not set
CONFIG_COMPILE_COMMANDS=y
CONFIG_PARALLEL_JOBS=0
