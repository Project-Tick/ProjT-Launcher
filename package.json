{
  "name": "projtlauncher",
  "version": "0.0.4-1",
  "description": "Project Tick - Official websites for ProjT Launcher, toml++ and more",
  "scripts": {
    "build": "npm run build:tomlplusplus && eleventy && npm run copy:tomlplusplus",
    "build:tomlplusplus": "node ./scripts/build-tomlplusplus.mjs",
    "copy:tomlplusplus": "mkdir -p _site/tomlplusplus && cp -r website/tomlplusplus/html/* _site/tomlplusplus/",
    "watch": "eleventy --watch",
    "serve": "eleventy --serve",
    "start": "eleventy --serve",
    "debug": "DEBUG=* npx eleventy",
    "lint": "markdownlint .",
    "lint:fix": "markdownlint --fix .",
    "update-contributors": "node ./scripts/update-contributors.mjs",
    "setup:doxygen": "node ./scripts/setup-doxygen.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Project-Tick/ProjT-Launcher.git"
  },
  "author": {
    "name": "YongDo-Hyun",
    "email": "froster12@naver.com",
    "url": "https://github.com/YongDo-Hyun"
  },
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/Project-Tick/ProjT-Launcher/issues"
  },
  "homepage": "https://projtlauncher.projecttick.org.tr/",
  "devDependencies": {
    "@11ty/eleventy": "3.1.2",
    "@11ty/eleventy-fetch": "5.1.0",
    "@11ty/eleventy-img": "6.0.4",
    "@11ty/eleventy-navigation": "1.0.4",
    "@11ty/eleventy-plugin-rss": "2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "@fontsource/inter": "5.2.8",
    "@fortawesome/fontawesome-free": "6.7.2",
    "axios": "1.12.2",
    "clean-css": "5.3.3",
    "luxon": "3.7.2",
    "markdown-it": "14.1.0",
    "markdown-it-anchor": "9.2.0",
    "markdown-it-table-of-contents": "0.9.0",
    "markdownlint-cli": "0.45.0",
    "markdownlint-cli2": "^0.20.0"
  },
  "packageManager": "pnpm@10.18.3"
}
