# Toolchain Directory
#
# This directory is intentionally kept empty for git subtrees.
#
# To add GCC subtree:
#   git subtree add --prefix=toolchain/gcc \
#     https://gcc.gnu.org/git/gcc.git releases/gcc-14 --squash
#
# To add LLVM subtree:
#   git subtree add --prefix=toolchain/llvm \
#     https://github.com/llvm/llvm-project.git llvmorg-18.1.0 --squash
#
# The build system (mk/toolchain-gcc.mk, mk/toolchain-llvm.mk) will
# automatically detect subtrees and use them, or download sources
# if no subtree is present.
